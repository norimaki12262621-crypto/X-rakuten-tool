# Groq API
GROQ_API_KEY=
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# 楽天API
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_ACCESS_KEY=

# X (Twitter) API
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Google Sheets（スプレッドシート連携）
# スプレッドシートのIDをURLから取得: https://docs.google.com/spreadsheets/d/[ここがID]/edit
GOOGLE_SHEET_ID=
# サービスアカウントのメールアドレス
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# サービスアカウントの秘密鍵（改行は \n に変換して1行で設定）
GOOGLE_PRIVATE_KEY=
